---
interface Props {
  initials?: string;
  size?: 'small' | 'medium' | 'large';
}

const { initials = 'CR', size = 'medium' } = Astro.props;
---

<a href="/" class:list={['logo', size]} aria-label="Home">
  <img src="/initials.svg" alt={initials} class="logo-img" />
</a>

<style>
  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform var(--transition-fast);
  }

  .logo:hover {
    transform: scale(1.05);
  }

  .logo.small {
    width: 40px;
    height: 40px;
  }

  .logo.medium {
    width: 56px;
    height: 56px;
  }

  .logo.large {
    width: 72px;
    height: 72px;
  }

  .logo-img {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
  }
</style>

---
import en from '../data/en.json';

interface Props {
  orientation?: 'vertical' | 'horizontal';
}

const { orientation = 'vertical' } = Astro.props;
const currentPath = Astro.url.pathname;
const { nav } = en;

const navItems = [
  { href: '/about', label: nav.about, i18nKey: 'nav.about' },
  { href: '/experience', label: nav.experience, i18nKey: 'nav.experience' },
  { href: '/skills', label: nav.skills, i18nKey: 'nav.skills' },
  { href: '/education', label: nav.education, i18nKey: 'nav.education' },
];
---

<nav class:list={['navigation', orientation]}>
  <ul class="nav-list">
    {navItems.map((item) => (
      <li class="nav-item">
        <a
          href={item.href}
          class:list={['nav-link', { active: currentPath === item.href || currentPath === item.href + '/' }]}
          data-i18n={item.i18nKey}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .navigation {
    width: 100%;
  }

  .nav-list {
    list-style: none;
    display: flex;
    gap: var(--spacing-sm);
  }

  .navigation.vertical .nav-list {
    flex-direction: column;
  }

  .navigation.horizontal .nav-list {
    flex-direction: row;
    justify-content: center;
  }

  .nav-link {
    display: block;
    padding: var(--spacing-sm) var(--spacing-md);
    color: var(--color-text-light);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast), color var(--transition-fast);
    font-weight: 500;
  }

  .nav-link:hover {
    background-color: var(--color-surface);
    color: var(--color-text);
  }

  .nav-link.active {
    background-color: var(--color-primary);
    color: white;
  }

  .nav-link.active:hover {
    background-color: var(--color-primary-dark);
    color: white;
  }
</style>

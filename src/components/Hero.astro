---
import SocialIcons from "./SocialIcons.astro";

interface Props {
  name: string;
  motto: string;
  ctaText: string;
  ctaHref?: string;
  github?: string;
  linkedin?: string;
  email?: string;
}

const {
  name,
  motto,
  ctaText,
  ctaHref = "/experience",
  github,
  linkedin,
  email,
} = Astro.props;
---

<section class="hero">
  <div class="hero-image">
    <img src="/images/photo.jpeg" alt={name} class="hero-photo" />
  </div>

  <h1 class="hero-name" data-i18n="personal.name">{name}</h1>
  <p class="hero-motto" data-i18n="personal.motto">{motto}</p>

  <a href={ctaHref} class="hero-cta">
    <span data-i18n="personal.ctaText">{ctaText}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M5 12h14M12 5l7 7-7 7"></path>
    </svg>
  </a>

  <div class="hero-social">
    <SocialIcons github={github} linkedin={linkedin} email={email} />
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--spacing-2xl) 0;
    min-height: calc(100vh - var(--spacing-2xl) * 2);
    justify-content: center;
    position: relative;
  }

  .hero::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -73%);
    width: 200vw;
    height: 200vh;
    background: radial-gradient(
      circle,
      rgba(87, 67, 67, 0.25) 0%,
      rgba(87, 67, 67, 0.15) 25%,
      rgba(87, 67, 67, 0.08) 50%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  [data-theme="light"] .hero::before {
    opacity: 0;
  }

  .hero > * {
    position: relative;
    z-index: 1;
  }

  .hero-image {
    margin-bottom: var(--spacing-xl);
  }

  .hero-photo {
    width: 180px;
    height: 180px;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .hero-name {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--spacing-sm);
    color: var(--color-text);
  }

  .hero-motto {
    font-size: var(--font-size-lg);
    color: var(--color-text-light);
    max-width: 400px;
    margin-bottom: var(--spacing-xl);
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md) var(--spacing-xl);
    background: linear-gradient(
      135deg,
      var(--color-primary),
      var(--color-accent)
    );
    color: white;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: var(--font-size-base);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
    margin-bottom: var(--spacing-xl);
  }

  .hero-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(87, 67, 67, 0.4);
    color: white;
  }

  .hero-cta svg {
    transition: transform var(--transition-fast);
  }

  .hero-cta:hover svg {
    transform: translateX(4px);
  }

  .hero-social {
    margin-top: var(--spacing-md);
  }

  @media (max-width: 768px) {
    .hero::before {
      display: none;
    }

    .hero {
      min-height: auto;
      padding: var(--spacing-xl) 0;
    }

    .hero-photo {
      width: 140px;
      height: 140px;
    }

    .hero-name {
      font-size: var(--font-size-2xl);
    }
  }
</style>

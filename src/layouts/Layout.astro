---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import Topbar from "../components/Topbar.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import LanguageDropdown from "../components/LanguageDropdown.astro";
import en from "../data/en.json";
import es from "../data/es.json";

interface Props {
  title?: string;
  showSidebar?: boolean;
}

const { title = "César Rayas", showSidebar = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/initials.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content="Leading technical excellence through team empowerment" />
    <meta name="keywords" content="César Rayas, software engineer, tech lead, software architecture, development, react, next.js, nextjs, typescript, python, rust, node.js, full stack developer, frontend, backend, react native, AWS, docker, GraphQL, REST API, Guadalajara, Mexico" />
    <meta property="og:title" content="César Rayas" />
    <meta property="og:description" content="Leading technical excellence through team empowerment" />
    <meta property="og:image" content="https://cesray.github.io/images/og-image.jpeg" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="César Rayas" />
    <meta name="twitter:description" content="Leading technical excellence through team empowerment" />
    <meta name="twitter:image" content="https://cesray.github.io/images/og-image.jpeg" />
    <script is:inline>
      // Prevent flash of wrong theme
      const theme =
        localStorage.getItem("theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");
      document.documentElement.setAttribute("data-theme", theme);

      // Set html lang attribute
      var lang = localStorage.getItem("lang") || "en";
      document.documentElement.setAttribute("lang", lang);
    </script>
  </head>
  <body>
    <div class="controls-wrapper">
      <LanguageDropdown />
      <ThemeToggle />
    </div>
    <Topbar />
    <div class:list={["layout", { "no-sidebar": !showSidebar }]}>
      <main class="content">
        <slot />
      </main>
      {showSidebar && <Sidebar />}
    </div>
    <script is:inline define:vars={{ en, es }}>
      (function() {
        var lang = localStorage.getItem("lang") || "en";
        if (lang === "en") return;

        var locales = { en: en, es: es };
        var data = locales[lang];
        if (!data) return;

        function resolve(obj, path) {
          return path.split(".").reduce(function(o, k) {
            return o && o[k];
          }, obj);
        }

        document.querySelectorAll("[data-i18n]").forEach(function(el) {
          var key = el.getAttribute("data-i18n");
          var value = resolve(data, key);
          if (value !== undefined) {
            var replaceAttr = el.getAttribute("data-i18n-replace");
            if (replaceAttr) {
              var parts = replaceAttr.split(":");
              value = value.replace(parts[0], parts[1]);
            }
            el.innerHTML = value;
          }
        });

        document.querySelectorAll("[data-i18n-placeholder]").forEach(function(el) {
          var key = el.getAttribute("data-i18n-placeholder");
          var value = resolve(data, key);
          if (value !== undefined) {
            el.setAttribute("placeholder", value);
          }
        });
      })();
    </script>
  </body>
</html>

<style>
  .controls-wrapper {
    position: fixed;
    top: var(--spacing-md);
    right: var(--spacing-md);
    z-index: 200;
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .layout {
    min-height: 100vh;
    display: flex;
  }

  .content {
    flex: 1;
    max-width: var(--content-max-width);
    margin-left: var(--sidebar-width);
    padding: var(--spacing-2xl);
  }

  .no-sidebar .content {
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 768px) {
    .controls-wrapper {
      display: none;
    }

    .content {
      margin-left: 0;
      padding: var(--spacing-lg);
      padding-top: calc(var(--topbar-height) + var(--spacing-lg));
    }
  }
</style>

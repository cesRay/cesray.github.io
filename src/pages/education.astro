---
import Layout from "../layouts/Layout.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import en from "../data/en.json";

const { education, pages } = en;
---

<Layout title="César Rayas">
  <section class="education-page">
    <h1 class="page-title" data-i18n="pages.education.title">{pages.education.title}</h1>
    <p class="page-description" data-i18n="pages.education.description">
      {pages.education.description}
    </p>

    <div class="education-list">
      {
        education.map((edu, i) => (
          <ExperienceCard
            title={edu.title}
            subtitle={edu.subtitle}
            subtitleUrl={edu.subtitleUrl}
            period={edu.period}
            description={edu.description}
            i18nPrefix={`education.${i}`}
          />
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .education-page {
    padding: var(--spacing-lg) 0;
  }

  .page-title {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--spacing-sm);
  }

  .page-description {
    color: var(--color-text-light);
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-2xl);
  }

  .education-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }
</style>

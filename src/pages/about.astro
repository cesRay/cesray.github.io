---
import Layout from "../layouts/Layout.astro";
import en from "../data/en.json";
import es from "../data/es.json";

const { personal, pages } = en;
const esPages = es.pages;

// Calculate age
const birthDate = new Date(1997, 3, 18); // April 18, 1997
const today = new Date();
let age = today.getFullYear() - birthDate.getFullYear();
const monthDiff = today.getMonth() - birthDate.getMonth();
if (
  monthDiff < 0 ||
  (monthDiff === 0 && today.getDate() < birthDate.getDate())
) {
  age--;
}
---

<Layout title="César Rayas">
  <section class="about-page">
    <div class="about-header">
      <img
        src="/images/about-me-photo.jpeg"
        alt={personal.name}
        class="about-photo"
      />
      <div class="about-intro">
        <h1 class="page-title" data-i18n="pages.about.title">{pages.about.title}</h1>
        <p class="about-tagline" data-i18n="personal.motto">{personal.motto}</p>
        <div class="about-chips">
          <span class="info-chip" data-i18n="pages.about.ageChip" data-i18n-replace={`{age}:${age}`}>{pages.about.ageChip.replace("{age}", String(age))}</span>
          <span class="info-chip" data-i18n="pages.about.locationChip">{pages.about.locationChip}</span>
        </div>
      </div>
    </div>

    <div class="about-content">
      {pages.about.sections.map((section, si) => (
        <div class="about-section">
          <h2 data-i18n={`pages.about.sections.${si}.heading`}>{section.heading}</h2>
          {section.paragraphs.map((p, pi) => (
            <p data-i18n={`pages.about.sections.${si}.paragraphs.${pi}`} set:html={p} />
          ))}
        </div>
      ))}
    </div>

    <div class="about-gallery">
      <div class="gallery-grid">
        <img src="/images/mohara.jpg" alt="Mohara" class="gallery-photo" />
        <img src="/images/teach.jpg" alt="Teaching" class="gallery-photo" />
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-page {
    padding: var(--spacing-lg) 0;
  }

  .about-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-2xl);
  }

  .about-photo {
    width: 150px;
    height: 150px;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .about-intro {
    flex: 1;
  }

  .page-title {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--spacing-sm);
  }

  .about-tagline {
    color: var(--color-text-light);
    font-size: var(--font-size-lg);
  }

  .about-chips {
    display: flex;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-md);
  }

  .info-chip {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-md);
    background-color: var(--color-surface);
    color: var(--color-text);
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    font-weight: 500;
    border: 1px solid var(--color-border);
  }

  .about-content {
    margin-bottom: var(--spacing-2xl);
  }

  .about-section {
    margin-bottom: var(--spacing-xl);
  }

  .about-section h2 {
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-md);
    color: var(--color-primary);
  }

  .about-section p {
    color: var(--color-text);
    line-height: 1.8;
    margin-bottom: var(--spacing-md);
  }

  .about-section p:last-child {
    margin-bottom: 0;
  }

  .about-list {
    color: var(--color-text);
    line-height: 1.8;
    margin-left: var(--spacing-lg);
    margin-top: var(--spacing-sm);
  }

  .about-list li {
    margin-bottom: var(--spacing-sm);
  }

  .about-gallery h2 {
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-lg);
    color: var(--color-primary);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }

  .gallery-photo {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  @media (max-width: 768px) {
    .about-header {
      flex-direction: column;
      text-align: center;
    }

    .about-photo {
      width: 120px;
      height: 120px;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

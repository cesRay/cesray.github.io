---
import Layout from "../layouts/Layout.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import en from "../data/en.json";

const { experience, pages } = en;
---

<Layout title="César Rayas">
  <section class="experience-page">
    <h1 class="page-title" data-i18n="pages.experience.title">{pages.experience.title}</h1>
    <p class="page-description" data-i18n="pages.experience.description">
      {pages.experience.description}
    </p>

    <div class="experience-list">
      {
        experience.map((job, i) => (
          <ExperienceCard
            title={job.title}
            subtitle={job.subtitle}
            subtitleUrl={job.subtitleUrl}
            period={job.period}
            description={job.description}
            i18nPrefix={`experience.${i}`}
          />
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .experience-page {
    padding: var(--spacing-lg) 0;
  }

  .page-title {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--spacing-sm);
  }

  .page-description {
    color: var(--color-text-light);
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-2xl);
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }
</style>

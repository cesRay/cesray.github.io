---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import en from "../data/en.json";

const { personal } = en;
---

<Layout title="César Rayas" showSidebar={false}>
  <Hero
    name={personal.name}
    motto={personal.motto}
    ctaText={personal.ctaText}
    ctaHref="/about"
    github={personal.socials.github}
    linkedin={personal.socials.linkedin}
    email={personal.socials.email}
  />
</Layout>
